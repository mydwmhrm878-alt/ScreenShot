SelectionBtn.MouseButton1Click:Connect(function()
	UiEffectsModule.ToggleFrame(OptionsFrame, false, OPTIONS_SIZE)
	SelectionBox.Visible = false

	local UserInputService = game:GetService("UserInputService")
	local startPos: Vector2
	local isSelecting = false

	local inputBeganConn: RBXScriptConnection
	local inputChangedConn: RBXScriptConnection
	local inputEndedConn: RBXScriptConnection

	inputBeganConn = UserInputService.InputBegan:Connect(function(input, gpe)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			startPos = UserInputService:GetMouseLocation()
			SelectionBox.Position = UDim2.new(0, startPos.X, 0, startPos.Y - 36)
			SelectionBox.Size = UDim2.new(0, 0, 0, 0)
			SelectionBox.Visible = true
			isSelecting = true
		end
	end)

	inputChangedConn = UserInputService.InputChanged:Connect(function(input)
		if isSelecting and input.UserInputType == Enum.UserInputType.MouseMovement then
			local currentPos = UserInputService:GetMouseLocation()
			local sizeX = currentPos.X - startPos.X
			local sizeY = currentPos.Y - startPos.Y
			SelectionBox.Size = UDim2.new(0, sizeX, 0, sizeY)
		end
	end)

	inputEndedConn = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and isSelecting then
			isSelecting = false
			SelectionBox.Visible = false

			inputBeganConn:Disconnect()
			inputChangedConn:Disconnect()
			inputEndedConn:Disconnect()

			local finalSize = SelectionBox.Size
			local finalPos = SelectionBox.Position

			local capturedView = captureScene(finalSize, finalPos, true)
			saveToGallery(capturedView)
		end
	end)
end)
