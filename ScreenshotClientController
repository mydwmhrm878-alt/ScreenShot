local function createFakeSkybox(parent: ViewportFrame, camCFrame: CFrame)
	local oldSky = parent:FindFirstChild("FakeSkybox")
	if oldSky then oldSky:Destroy() end

	local realSkyColor = Color3.fromRGB(116, 177, 219)

	parent.BackgroundTransparency = 0
	parent.BackgroundColor3 = realSkyColor
end

local function applyProfessionalLighting(viewport: ViewportFrame)
	viewport.Ambient = Color3.fromRGB(175, 185, 195)

	viewport.LightColor = Color3.fromRGB(255, 255, 250)

	viewport.LightDirection = Vector3.new(0.4, -1, -0.4)
end

local function captureScene(size: UDim2, position: UDim2, isSelection: boolean): ViewportFrame
	local viewportFrame = Instance.new("ViewportFrame")
	viewportFrame.Size = size
	viewportFrame.Position = position

	local viewCam = Instance.new("Camera")
	viewCam.CFrame = Camera.CFrame
	viewCam.FieldOfView = Camera.FieldOfView

	if isSelection then
		local screenScaleX = size.X.Offset / Camera.ViewportSize.X
		local screenScaleY = size.Y.Offset / Camera.ViewportSize.Y
		local finalScale = math.max(screenScaleX, screenScaleY)
		if finalScale > 0 then
			viewCam.FieldOfView = math.clamp(Camera.FieldOfView * finalScale, 1, 120)
		end
	end

	viewCam.Parent = viewportFrame
	viewportFrame.CurrentCamera = viewCam

	createFakeSkybox(viewportFrame, viewCam.CFrame)
	applyProfessionalLighting(viewportFrame)

	local playerName: string = Player.Name
	for _, object in ipairs(Workspace:GetChildren()) do
		if object:IsA("BasePart") or object:IsA("Model") or object:IsA("Folder") then
			if not object:IsA("Terrain") and object.Name ~= playerName and object.Name ~= "FakeSkybox" and object.Name ~= "Camera" then

				local clone: Instance? = nil
				local success, err = pcall(function()
					object.Archivable = true
					clone = object:Clone()
				end)

				if success and clone then
					clone.Parent = viewportFrame
				end
			end 
		end
	end

	local character: Model? = Player.Character :: Model?
	if character then
		local activeCharacter = character :: Model
		local charClone: Model? = nil

		local success, err = pcall(function()
			activeCharacter.Archivable = true
			charClone = activeCharacter:Clone() :: Model
		end)

		if success and charClone then
			local rootPart = activeCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?
			local cloneRoot = charClone:FindFirstChild("HumanoidRootPart") :: BasePart?
			if rootPart and cloneRoot then
				cloneRoot.CFrame = rootPart.CFrame
			end

			charClone.Parent = viewportFrame
		end
	end

	return viewportFrame
end

local function saveToGallery(viewportFrame: ViewportFrame)
	local card = Instance.new("Frame")
	card.BackgroundColor3 = Color3.fromRGB(24, 24, 26)
	card.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(45, 45, 50)
	stroke.Thickness = 1
	stroke.Parent = card

	viewportFrame.Size = UDim2.new(1, -12, 1, -12)
	viewportFrame.Position = UDim2.new(0, 6, 0, 6)
	viewportFrame.Parent = card

	local clickBtn = Instance.new("TextButton")
	clickBtn.Size = UDim2.new(1, 0, 1, 0)
	clickBtn.BackgroundTransparency = 1
	clickBtn.Text = ""
	clickBtn.Parent = card

	clickBtn.MouseButton1Click:Connect(function()
		local oldView = PopupFrame:FindFirstChildOfClass("ViewportFrame")
		if oldView then oldView:Destroy() end

		local bigView = viewportFrame:Clone()
		bigView.Size = UDim2.new(1, -40, 1, -80)
		bigView.Position = UDim2.new(0, 20, 0, 60)

		local currentCam = bigView.CurrentCamera :: Camera
		if currentCam then
			createFakeSkybox(bigView, currentCam.CFrame)
		end

		applyProfessionalLighting(bigView)

		bigView.Parent = PopupFrame
		UiEffectsModule.ToggleFrame(PopupFrame, true, POPUP_SIZE)
	end)

	local deleteBtn = Instance.new("TextButton")
	deleteBtn.Size = UDim2.new(0, 24, 0, 24)
	deleteBtn.Position = UDim2.new(1, -28, 0, 4)
	deleteBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	deleteBtn.BackgroundTransparency = 0.3
	deleteBtn.Text = "×"
	deleteBtn.TextColor3 = Color3.fromRGB(255, 85, 85)
	deleteBtn.TextSize = 18
	deleteBtn.Font = Enum.Font.GothamBold
	deleteBtn.ZIndex = 5
	deleteBtn.Parent = card

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(1, 0)
	btnCorner.Parent = deleteBtn

	deleteBtn.MouseButton1Click:Connect(function()
		card:Destroy()
	end)

	card.Parent = ScrollGui
	ScreenshotEvent:FireServer("Capture")
end

